packaging/pdfbud.icns

# Signing and publishing keys, never committed
*.p12
*.p8
*.pem
*.key
*.cer
*.mobileprovision
*.keychain
*.keychain-db
.netrc

# PDFs are generated by the tests or downloaded by a script, never stored here
*.pdf

# Videos and scratch files stay outside the repo; the README uses a small GIF in docs/
*.mp4
*.mov
*.log
tmp/
scratch/

# Private notes, local config and assistant tooling
CLAUDE.md
.claude/
.impeccable/
.env
.env.*

# macOS and editors
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/
*.swp
*~
